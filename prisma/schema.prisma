generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Alien {
  alienId     String   @id @default(uuid())
  name        String
  species     String?
  description String?
  imageUrl    String?
  isUnlocked  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}