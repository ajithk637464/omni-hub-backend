generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Alien {
  AlienId              Int      @id @default(autoincrement())
  AlienGuid            String   @unique @default(uuid())
  AlienName            String
  Species              String?
  HomePlanet           String?
  Description          String?
  EnergyConsumption    Int      @default(0)
  Strength             Int      @default(0)
  Speed                Int      @default(0)
  Intelligence         Int      @default(0)
  Accuracy             Int      @default(0)
  AlienLevel           Int      @default(1)
  Unlocked             Boolean  @default(false)
  IsActive             Boolean  @default(true)
  SortOrder            Int      @default(0)
  Created              DateTime @default(now())
  CreatedUserGuid      String?
  CreatedUserGroupGuid String?
  Updated              DateTime @updatedAt
  UpdatedUserGuid      String?
  UpdatedUserGroupGuid String?

  AlienAlienPowers AlienAlienPower[]
}

model AlienPower {
  AlienPowerId         Int      @id @default(autoincrement())
  AlienPowerGuid       String   @unique @default(uuid())
  AlienPowerName       String
  Description          String?
  PowerType            String
  PowerLevel           Int
  IsActive             Boolean  @default(true)
  SortOrder            Int      @default(0)
  Created              DateTime @default(now())
  CreatedUserGuid      String?
  CreatedUserGroupGuid String?
  Updated              DateTime @updatedAt
  UpdatedUserGuid      String?
  UpdatedUserGroupGuid String?

  AlienAlienPowers AlienAlienPower[]
}

model AlienAlienPower {
  AlienId      Int
  AlienPowerId Int
  IsMainPower  Boolean @default(false)

  Alien      Alien      @relation(fields: [AlienId], references: [AlienId])
  AlienPower AlienPower @relation(fields: [AlienPowerId], references: [AlienPowerId])

  @@id([AlienId, AlienPowerId])
}
